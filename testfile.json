pip install --user awscurl
export PATH=$PATH:~/.local/bin

export API=$(aws cloudformation describe-stacks --stack-name idfmcp-service-board-dev \
  --query "Stacks[0].Outputs[?OutputKey=='ApiUrl'].OutputValue" --output text | sed 's:/$::')
export OI="service-board $(printf '%s' '{"UserId":"ekykaho"}' | base64 -w0)"
export SVC=0eb7ed33-4af8-4baf-860b-b804a7a6033c
export PLAN=e5f23be6-32b9-4863-823e-4d99a40178c0
export ID=smoke-$(date +%H%M%S)
sb() { awscurl --service execute-api --region eu-central-1 -H "X-Broker-API-Version: 2.17" "$@"; echo; }
echo "API=$API  ID=$ID"


# 1) unsigned call is rejected -> 401
curl -s -o /dev/null -w "unsigned: %{http_code}\n" "$API/v2/catalog"

# 2) catalog -> 200 with devstack-mcp
sb "$API/v2/catalog"

# 3) PUT without accepts_incomplete -> 422 AsyncRequired
sb -X PUT -H "X-Broker-API-Originating-Identity: $OI" -H "Content-Type: application/json" \
  -d "{\"service_id\":\"$SVC\",\"plan_id\":\"$PLAN\",\"context\":{\"project_id\":\"proj-smoke\"},\"parameters\":{\"alert_email\":\"you@company.com\"}}" \
  "$API/v2/service_instances/$ID"

# 4) PUT without alert_email -> 400
sb -X PUT -H "X-Broker-API-Originating-Identity: $OI" -H "Content-Type: application/json" \
  -d "{\"service_id\":\"$SVC\",\"plan_id\":\"$PLAN\",\"context\":{\"project_id\":\"proj-smoke\"}}" \
  "$API/v2/service_instances/$ID?accepts_incomplete=true"

# 5) real booking -> 202 {"operation": "..."}
sb -X PUT -H "X-Broker-API-Originating-Identity: $OI" -H "Content-Type: application/json" \
  -d "{\"service_id\":\"$SVC\",\"plan_id\":\"$PLAN\",\"context\":{\"project_id\":\"proj-smoke\"},\"parameters\":{\"alert_email\":\"you@company.com\"}}" \
  "$API/v2/service_instances/$ID?accepts_incomplete=true"

# 6) same booking again -> 202 with the SAME operation
sb -X PUT -H "X-Broker-API-Originating-Identity: $OI" -H "Content-Type: application/json" \
  -d "{\"service_id\":\"$SVC\",\"plan_id\":\"$PLAN\",\"context\":{\"project_id\":\"proj-smoke\"},\"parameters\":{\"alert_email\":\"you@company.com\"}}" \
  "$API/v2/service_instances/$ID?accepts_incomplete=true"

# 7) poll -> {"state": "in progress", ...}
sb "$API/v2/service_instances/$ID/last_operation"

# 8) unknown instance -> 410
sb "$API/v2/service_instances/does-not-exist/last_operation"



aws logs tail /aws/lambda/idfmcp-request-approval-dev --since 5m
aws dynamodb get-item --table-name idfmcp-instances-dev \
  --key "{\"instance_id\":{\"S\":\"$ID\"},\"project_id\":{\"S\":\"proj-smoke\"}}" \
  --query "Item.[state.S,last_operation_state.S,approval_requested_at.S]"



aws logs tail /aws/lambda/idfmcp-apply-decision-dev --since 10m
sb "$API/v2/service_instances/$ID/last_operation"     # {"state": "succeeded", ...}
